# Same Parse Server backend the switch-food / switch-driver / switch-manager RN apps and
# the switch-dashboard / switch-finance web apps use.
# Not secrets: the app id ships inside every published RN app binary already.
NEXT_PUBLIC_PARSE_APP_ID=switchApp
NEXT_PUBLIC_PARSE_SERVER_URL=https://api.switchfood.net

# Local Parse Server, if you run one (see the commented-out alternative in the RN apps'
# src/configs/index.js):
# NEXT_PUBLIC_PARSE_SERVER_URL=http://192.168.1.33
