# Same Parse Server backend the switch-food / switch-driver / switch-manager RN apps and
# the switch-dashboard / switch-finance web apps use.
# Not secrets: the app id ships inside every published RN app binary already.
NEXT_PUBLIC_PARSE_APP_ID=switchApp
NEXT_PUBLIC_PARSE_SERVER_URL=https://api.switchfood.net

# Local development: `npm run dev:local` points this app at the local switch-server-v2
# (http://localhost:1337, seeded test data) and overrides the URL above. Start the whole
# platform with `pnpm dev:all` in switch-server-v2 (docs/04-local-dev.md).

# Pusher, for the server's live events to this console (a driver declining an order,
# switch-server-v2 D-23). The key is public: it ships in the driver app already. Channels
# are private, so the server signs every subscription (`authorizeOpsChannel`). Leave the
# key empty to run without live events; the board still catches up on its next refresh.
NEXT_PUBLIC_PUSHER_KEY=b4cb8ea88897dba8ec3b
NEXT_PUBLIC_PUSHER_CLUSTER=eu
